# OpenCode Go API key. When set, OpenCode Go is used for merchant
# classification and Ask answers INSTEAD of the Meta Model API below
# (it takes precedence when both keys are set). Leave unset to use Meta.
OPENCODE_API_KEY=
# Model used on OpenCode Go for classification and Ask.
OPENCODE_MODEL=muse-spark-1.3-contributor
# Meta Model API key (starts with LLM_). Used for merchant classification
# and for Ask answers when OPENCODE_API_KEY is not set. Without either
# key, classification stays rules-only and Ask answers deterministically
# from the records.
MUSE_API_KEY=
# Meta Model API base URL.
MUSE_API_BASE_URL=https://api.meta.ai
# Model used for classification and Ask.
MUSE_MODEL=muse-spark-1.3-contributor
CHITRAGUPTA_DATA_DIR=
CHITRAGUPTA_STORE_DIR=
